# Supabase configuration
# Copy to .env.local and fill in real values from your Supabase project dashboard.
# Never commit the filled-in file — .gitignore excludes .env.* and *.local.

SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. This ships to the client, so it is NOT a credential —
# your Row Level Security policies are the only thing protecting your data.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side only. Keep this out of any code that reaches the browser.
SUPABASE_SECRET_KEY=sb_secret_your_key_here
